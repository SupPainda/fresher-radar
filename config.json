  "search": {
    "days": 14,
    "results_per_search": 30,
    "delay_seconds": [
      4,
      9
    ],
    "test": {
      "title": "Solutions Engineer",
      "location": "Bengaluru",
      "preview_rows": 15,
      "boards_per_provider": 2
    },
    "on_block": {
      "cooldown_minutes": 5,
      "give_up_after": 3
    }
  },
  "titles": {
    "search": [
      "Associate Solutions Architect",
      "Solutions Engineer",
      "Pre-Sales Engineer",
      "Technical Consultant",
      "Forward Deployed Engineer",
      "Customer Engineer",
      "Implementation Engineer",
      "Associate Software Engineer backend",
      "Graduate Engineer Trainee AI ML",
      "Cloud Engineer",
      "MLOps Engineer",
      "Data Engineer",
      "AI Engineer",
      "GenAI Engineer",
      "Associate Technical Product Manager",
      "Technical Account Manager",
      "Generative AI Engineer",
      "LLM Engineer",
      "Agentic AI Engineer",
      "AI Developer",
      "Applied AI Engineer",
      "AI ML Intern",
      "GenAI Intern",
      "Data Engineering Intern",
      "Software Engineering Intern",
      "Data Science Intern"
    ],
    "want": [
      "solutions?\\s+(architect|engineer|consultant)",
      "pre-?\\s?sales",
      "(technical|tech)\\s+(consultant|account\\s+manager|product\\s+manager|solutions?)",
      "forward[\\s-]+deployed",
      "customer\\s+engineer",
      "implementation\\s+(engineer|consultant|specialist)",
      "backend|back-end",
      "platform\\s+engineer",
      "(graduate|engineer|associate)\\s+(engineer\\s+)?trainee|\\bGET\\b",
      "cloud\\s+(engineer|solutions?)",
      "mlops|ml\\s*ops|machine\\s+learning\\s+engineer|\\bml\\s+engineer|ai\\s*/?\\s*ml\\s+engineer",
      "\\bai\\s+engineer|gen\\s?ai|generative\\s+ai",
      "data\\s+engineer(?!ing)",
      "product\\s+manager|account\\s+manager",
      "\\bllms?\\b|large\\s+language\\s+model|prompt\\s+engineer|agentic|\\brag\\b|applied\\s+ai|\\bnlp\\s+engineer|\\bai\\s*(developer|specialist|application|solutions?\\s+engineer)",
      "(?=.*\\b(software|data|ai|ml|machine\\s+learning|gen\\s?ai|llm|nlp|backend|cloud|python|devops|engineer(ing)?|developer|solutions?|technical|tech)\\b).*\\bintern(ship)?\\b"
    ],
    "exclude": [
      "executive",
      "tele\\s?calling",
      "trainer",
      "mechanical|diploma|electrical|civil|\\bfpga\\b|clinical|shift operator",
      "\\berp\\b|\\bsap\\b|workday|netsuite|zoho",
      "salesforce",
      "dynamics|\\bd365\\b|business\\s+central|navision",
      "\\boracle\\b",
      "\\belv\\b",
      "\\banalysts?\\b"
    ],
    "drop": [
      "senior",
      "sr\\.?",
      "staff",
      "principal",
      "lead",
      "leader",
      "group",
      "head",
      "director",
      "vp",
      "avp",
      "vice president",
      "manager",
      "experienced",
      "ii",
      "iii",
      "iv",
      "sse",
      "intermediate"
    ],
    "level_codes": [
      "\\b[3-9][a-z]?\\s*$",
      "\\b(l|ba|sde|swe|se|ic|pm)[3-9]\\b"
    ],
    "seniority_words": [
      "senior",
      "sr\\.?",
      "staff",
      "principal",
      "lead",
      "head",
      "director"
    ],
    "manager_allowed": [
      "technical account manager",
      "product manager"
    ],
    "needs_entry_signal": [
      "solutions?\\s+architect"
    ],
    "entry_signal": [
      "\\b(associate|assoc|junior|jr|graduate|trainee|freshers?|entry[\\s-]level)\\b",
      "\\bi\\s*$"
    ],
    "internship": "\\bintern(?:ship)?\\b"
  },
  "filters": {
    "max_min_years": 2,
    "experience_context_chars": 60
  },
  "output": {
    "csv": "jobs.csv",
    "raw": "jobs_raw.pkl",
    "columns": {
      "title": "title",
      "company": "company",
      "fit": "fit",
      "scored_by": "scored by",
      "why": "why",
      "send": "send resume",
