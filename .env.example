# Copy to .env and adjust. .env is not committed; variables set in the shell take precedence.
# What to search for lives in config.json; this file says how this machine runs it.

# Folder for jobs.csv, jobs.db and jobs_raw.pkl (relative paths are from the project folder).
# Git ignores data/. Pointing this at a synced folder (e.g. OneDrive) keeps your statuses backed up.
JSEARCH_DATA_DIR=data

# true: Naukri, Indeed and the company boards run side by side. false: one after another (debugging).
JSEARCH_PARALLEL=true

# Optional, comma-separated, for the job sites (jobspy): user:pass@host:port,host2:port2
# Needed later for LinkedIn/Glassdoor. Credentials go here, never in config.json.
JSEARCH_PROXIES=

# Optional: an LLM API key. Used by --build-profile and to rescore the top 30 jobs with a reason each
# (cached, so later runs only pay for new top jobs). Without it, jobs are still ranked offline.
# The provider is detected from the key itself:
#   sk-ant-...  Anthropic (Claude)        AIza... / AQ...   Google Gemini (AI Studio)
#   sk-or-...   OpenRouter                xai-...   xAI (Grok)
# Provider-specific names work too: ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY, XAI_API_KEY.
LLM_API_KEY=

# Optional overrides. Defaults per provider live in config.json under ranking.llm.providers.
#   LLM_MODEL     e.g. gemini-3.5-flash, google/gemini-3.5-flash (OpenRouter), a grok-* model, claude-opus-5-5.
#                 Tried first; if it fails, the provider's model and fallback_models in config.json follow.
#                 If a model is rejected, the error lists the ones your key can use.
#   LLM_BASE_URL  any OpenAI-compatible endpoint (with a key that isn't recognised, this makes it
#                 "openai-compatible"), or a proxy in front of one of the providers above.
#   LLM_PROVIDER  force one of: anthropic, gemini, openrouter, xai, openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_PROVIDER=

# Optional: email the top jobs (as many as ranking.llm.top_n) after every scraping run; --refilter sends
# only with --email. For Gmail, EMAIL_APP_PASSWORD is an app password (needs 2-step verification):
# https://myaccount.google.com/apppasswords. Spaces in it are fine. EMAIL_TO defaults to EMAIL_FROM and
# takes a comma-separated list. Another provider: change email.smtp_host / smtp_port in config.json.
EMAIL_FROM=
EMAIL_APP_PASSWORD=
EMAIL_TO=
